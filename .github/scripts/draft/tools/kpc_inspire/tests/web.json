{
 "routes": [
  {
   "match": [
    "data.europa.eu/sparql",
    "dcat:distribution"
   ],
   "file": "web/sparql_details.json"
  },
  {
   "match": [
    "data.europa.eu/sparql",
    "?cat dcat:dataset ?d"
   ],
   "file": "web/sparql_cats.json"
  },
  {
   "match": [
    "data.europa.eu/sparql",
    "bif:contains"
   ],
   "file": "web/sparql_text.json"
  },
  {
   "match": [
    "geometadatensuche.inspire.gv.at",
    "GetRecords"
   ],
   "file": "web/csw_disabled.xml"
  },
  {
   "match": [
    "k4test.example.gv.at/wfs",
    "GetCapabilities"
   ],
   "file": "web/wfs_caps.xml"
  },
  {
   "match": [
    "k4test.example.gv.at/arcgis/rest/services/Schutz/MapServer?f=json"
   ],
   "file": "web/arcgis.json"
  },
  {
   "match": [
    "k4test.example.gv.at/ogcapi/collections"
   ],
   "file": "web/collections.json"
  },
  {
   "match": [
    ".zip"
   ],
   "file": "web/file.zip",
   "headers": {
    "Content-Type": "application/zip",
    "Content-Length": "150"
   }
  }
 ]
}