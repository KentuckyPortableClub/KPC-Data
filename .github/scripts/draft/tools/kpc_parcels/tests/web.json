{
 "routes": [
  {
   "match": [
    "State_County/MapServer/1/query"
   ],
   "file": "web/county.json"
  },
  {
   "match": [
    "OWNER = 'CITY OF K4TEST'"
   ],
   "file": "web/a_same.json"
  },
  {
   "match": [
    "OWNER = 'K4TEST PRIVATE PERSON'"
   ],
   "file": "web/b_same.json"
  },
  {
   "match": [
    "Parcels/MapServer/0/query",
    "esriGeometryEnvelope",
    "where=1=1"
   ],
   "file": "web/b_near.json"
  },
  {
   "match": [
    "Parcels/MapServer/0/query",
    "geometry=-85.0,37.5"
   ],
   "file": "web/a_point.json"
  },
  {
   "match": [
    "Parcels/MapServer/0/query",
    "geometry=-85.1,37.6"
   ],
   "file": "web/b_point.json"
  },
  {
   "match": [
    "Parcels/MapServer/0?f=json"
   ],
   "file": "web/layer.json"
  }
 ]
}